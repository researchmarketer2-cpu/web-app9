{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app9",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "97bafa73-50e4-4216-8804-2b459b77fd1e","database_name": "web-app11" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5b81b18d5cb2449fa778deed4117909b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
